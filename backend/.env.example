# Server Configuration
PORT=4000
DATABASE_URL="postgresql://user:password@host:port/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:port/dbname"
JWT_SECRET="your_jwt_secret_key_minimum_32_characters"
FRONTEND_URL="http://localhost:3000"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=""

# SMTP Email Configuration (For Real-Time OTP delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="DOLSYX Team <your-email@gmail.com>"

# Cloudinary CDN (For secure image/media hosting)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ----------------------------------------------------------------------
# DOLSYX AI ASSISTANT CONFIGURATION
# ----------------------------------------------------------------------
# Active Provider: 'groq' | 'openai' | 'gemini' | 'custom' | 'pollinations'
# When GROQ_API_KEY is provided, Groq Llama 3.3 70B Versatile is used by default.
# When OPENAI_API_KEY is provided, OpenAI GPT-4o-mini is used by default.
# When GEMINI_API_KEY is provided, Google Gemini 1.5 Flash is used by default.
# If no key is set, zero-config high-speed OpenAI endpoint is used out-of-the-box.
GROQ_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Optional Custom Model and Base URL (for Ollama, vLLM, OpenRouter)
AI_PROVIDER=""
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""

# Operational Controls
AI_RATE_LIMIT_PER_MINUTE=30
