datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String            @id @default(uuid())
  username         String            @unique
  email            String?           @unique
  phoneNumber      String?           @unique
  password         String?
  avatarUrl        String?
  coverUrl         String?
  bio              String?
  statusMessage    String?
  xp               Int               @default(0)
  streakCount      Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  lastSeen         DateTime?         @default(now())
  lastLogin        DateTime?         @default(now())
  emailVerified    Boolean           @default(false)
  isOnline         Boolean           @default(false)
  fcmToken         String?           // For Firebase Cloud Messaging Push Notifications
  avatarPrivacy     String            @default("EVERYONE") // EVERYONE, MY_CONTACTS, EXCEPT, NOBODY
  lastSeenPrivacy   String            @default("EVERYONE") // EVERYONE, MY_CONTACTS, EXCEPT, NOBODY
  onlinePrivacy     String            @default("EVERYONE") // EVERYONE, SAME_AS_LAST_SEEN, NOBODY
  aboutPrivacy      String            @default("EVERYONE") // EVERYONE, MY_CONTACTS, EXCEPT, NOBODY
  readReceipts      Boolean           @default(true)
  disappearingTimer String           @default("OFF") // OFF, 24H, 7D, 90D
  statusPrivacyType String           @default("MY_CONTACTS") // MY_CONTACTS, EXCEPT, ONLY_SHARE
  statusPrivacyList String           @default("[]") // JSON string list of user IDs for Except/Only_Share
  avatarPrivacyExceptList String      @default("[]") // JSON string list of user IDs
  lastSeenPrivacyExceptList String    @default("[]") // JSON string list of user IDs
  aboutPrivacyExceptList String       @default("[]") // JSON string list of user IDs
  // Relations
  messages         Message[]
  participants     Participant[]
  notes            Note[]
  taskAssignments  TaskAssignment[]
  createdTasks     Task[]            @relation("CreatedBy")
  socialLinks      SocialLink[]
  sessions         Session[]
  deletedMessages  DeletedMessage[]
  statuses         Status[]
  statusViews      StatusView[]
  muting           StatusMute[]      @relation("Muter")
  mutedBy          StatusMute[]      @relation("Muted")
  blocking         UserBlock[]       @relation("Blocker")
  blockedBy        UserBlock[]       @relation("Blocked")
  contacts         Contact[]         @relation("UserContacts")
  savedBy          Contact[]         @relation("SavedByContacts")
  starredMessages  StarredMessage[]
  messageReactions MessageReaction[]
  
  // E2EE Relations
  devices          Device[]          @relation("UserDevices")
  encryptedBackups EncryptedBackup[] @relation("UserEncryptedBackups")
  
  // AI Platform Relations
  aiConversations  AIConversation[]
  aiImages         AIImage[]
  aiMemories       AIMemory[]
  aiUsages         AIUsage[]
}

model Status {
  id          String       @id @default(uuid())
  userId      String
  mediaUrl    String?
  mediaType   String       @default("TEXT") // TEXT, IMAGE, VIDEO
  caption     String?
  bgColor     String?      // For text-only statuses
  privacyType String       @default("MY_CONTACTS") // MY_CONTACTS, EXCEPT, ONLY_SHARE
  privacyList String       @default("[]") // JSON string list of user IDs at creation
  createdAt   DateTime     @default(now())
  expiresAt   DateTime     // 24 hours from creation

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  views       StatusView[]
  replies     Message[]    @relation("StatusReplies")
}

model StatusView {
  id       String   @id @default(uuid())
  statusId String
  viewerId String
  viewedAt DateTime @default(now())

  status   Status   @relation(fields: [statusId], references: [id], onDelete: Cascade)
  viewer   User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([statusId, viewerId])
}

model StatusMute {
  id        String   @id @default(uuid())
  muterId   String
  mutedId   String
  createdAt DateTime @default(now())

  muter     User     @relation("Muter", fields: [muterId], references: [id], onDelete: Cascade)
  muted     User     @relation("Muted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
}

model SocialLink {
  id       String @id @default(uuid())
  userId   String
  platform String // github, twitter, linkedin, portfolio
  url      String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  userAgent    String?
  ipAddress    String?
  isActive     Boolean  @default(true)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id           String        @id @default(uuid())
  name         String?
  isGroup      Boolean       @default(false)
  avatarUrl    String?
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  pinnedMessageId String?

  
  // Relations
  messages        Message[]
  participants    Participant[]
  tasks           Task[]
  pinnedMessages  PinnedMessage[]
}

model Participant {
  id             String       @id @default(uuid())
  userId         String
  conversationId String
  role           String       @default("MEMBER") // OWNER, ADMIN, MODERATOR, MEMBER
  createdAt      DateTime     @default(now())
  muteUntil      DateTime?
  isArchived     Boolean      @default(false)
  isLocked       Boolean      @default(false)
  isFavorite     Boolean      @default(false)
  isPinned       Boolean      @default(false)
  pinnedAt       DateTime?
  
  // Relations
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id              String           @id @default(uuid())
  content         String
  senderId        String
  conversationId  String
  parentMessageId String?          // For replies
  isEdited        Boolean          @default(false)
  isDeleted       Boolean          @default(false)
  mediaUrl        String?
  mediaType       String?          @default("TEXT") // TEXT, IMAGE, VIDEO, FILE, CODE_SNIPPET, LOCATION
  isForwarded     Boolean          @default(false)
  isViewOnce      Boolean          @default(false)
  isViewed        Boolean          @default(false)
  viewedAt        DateTime?
  latitude        Float?
  longitude       Float?
  locationTitle   String?
  isLiveLocation  Boolean          @default(false)
  liveExpiresAt   DateTime?
  isLiveEnded     Boolean          @default(false)
  createdAt       DateTime         @default(now())
  repliedStatusId String?          // For replying to statuses
  
  // Relations
  sender          User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parentMessage   Message?         @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: Cascade)
  repliedStatus   Status?          @relation("StatusReplies", fields: [repliedStatusId], references: [id], onDelete: SetNull)
  replies         Message[]        @relation("MessageReplies")
  receipts        MessageReceipt[]
  deletedForUsers DeletedMessage[]
  starredBy       StarredMessage[]
  reactions       MessageReaction[]
  pinnedMessages  PinnedMessage[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([mediaType])
}

model PinnedMessage {
  id             String       @id @default(uuid())
  conversationId String
  messageId      String
  pinnedById     String
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([conversationId, messageId])
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model MessageReceipt {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  status    String   @default("SENT") // SENT, DELIVERED, READ
  updatedAt DateTime @updatedAt
  
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId, userId])
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String   // Markdown string
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id             String           @id @default(uuid())
  title          String
  description    String?
  status         String           @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  dueDate        DateTime?
  userId         String           // Creator
  conversationId String?          // Associated Chat
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  
  creator        User             @relation("CreatedBy", fields: [userId], references: [id], onDelete: Cascade)
  conversation   Conversation?    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignments    TaskAssignment[]
}

model TaskAssignment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

model DeletedMessage {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())
  
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model Otp {
  id              String   @id @default(uuid())
  email           String   @unique
  code            String
  expiresAt       DateTime
  attempts        Int      @default(0)
  requestCount    Int      @default(0)
  lastRequestedAt DateTime @default(now())
  createdAt       DateTime @default(now())
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Contact {
  id              String   @id @default(uuid())
  userId          String   // owner
  contactId       String   // the saved user
  savedName       String?
  savedEmail      String?
  savedUsername   String?
  isFavorite      Boolean  @default(false)
  isBlocked       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  user    User @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)
  contact User @relation("SavedByContacts", fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([userId, contactId])
}

model StarredMessage {
  id        String   @id @default(uuid())
  userId    String
  messageId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
}

// ----------------------------------------------------------------------
// END-TO-END ENCRYPTION (E2EE) MODELS
// ----------------------------------------------------------------------

model Device {
  id                      String           @id @default(uuid())
  userId                  String
  deviceId                Int
  identityKeyPublic       String           // Base64 public Ed25519 identity key
  signedPreKeyPublic      String           // Base64 public X25519 signed pre-key
  signedPreKeySignature   String           // Signature of the pre-key
  createdAt               DateTime         @default(now())

  user                    User             @relation("UserDevices", fields: [userId], references: [id], onDelete: Cascade)
  oneTimePreKeys          OneTimePreKey[]
  sentEncryptedMessages     EncryptedMessage[] @relation("SentEncryptedMessages")
  receivedEncryptedMessages EncryptedMessage[] @relation("ReceivedEncryptedMessages")

  @@unique([userId, deviceId])
}

model OneTimePreKey {
  id          String   @id @default(uuid())
  deviceId    String
  keyId       Int
  publicKey   String   // Base64 public X25519 key
  
  device      Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, keyId])
}

model EncryptedBackup {
  id             String   @id @default(uuid())
  userId         String
  encryptedData  String   // AES-GCM encrypted backup of local state
  salt           String   // Argon2id salt
  nonce          String
  updatedAt      DateTime @default(now()) @updatedAt

  user           User     @relation("UserEncryptedBackups", fields: [userId], references: [id], onDelete: Cascade)
}

model EncryptedMessage {
  id                  String   @id @default(uuid())
  senderDeviceId      String
  recipientDeviceId   String
  type                Int      // 1 = PreKeyWhisperMessage, 2 = WhisperMessage
  ciphertext          String   // Base64 encrypted payload
  timestamp           DateTime @default(now())
  delivered           Boolean  @default(false)

  senderDevice        Device   @relation("SentEncryptedMessages", fields: [senderDeviceId], references: [id], onDelete: Cascade)
  recipientDevice     Device   @relation("ReceivedEncryptedMessages", fields: [recipientDeviceId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------
// PRODUCTION AI PLATFORM MODELS (ChatGPT-like + AI Image Generation)
// ----------------------------------------------------------------------

model AIConversation {
  id          String      @id @default(uuid())
  userId      String
  title       String      @default("New AI Chat")
  mode        String      @default("NORMAL") // NORMAL, TEMPORARY, CHAT_CONTEXT
  summary     String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    AIMessage[]
  images      AIImage[]
}

model AIMessage {
  id              String         @id @default(uuid())
  conversationId  String
  sender          String         // USER, AI, SYSTEM
  type            String         @default("USER_TEXT") // USER_TEXT, AI_TEXT, USER_IMAGE, AI_IMAGE, FILE, ERROR
  content         String
  model           String?
  status          String         @default("COMPLETED") // QUEUED, PROCESSING, STREAMING, COMPLETED, FAILED, CANCELLED
  tokenUsage      Int            @default(0)
  parentMessageId String?
  feedback        String?        // UP, DOWN
  metadata        String?        // JSON string for additional parameters
  createdAt       DateTime       @default(now())

  conversation    AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments     AIAttachment[]
  images          AIImage[]
}

model AIAttachment {
  id          String    @id @default(uuid())
  messageId   String
  userId      String
  storageKey  String
  mimeType    String
  size        Int
  metadata    String?   // JSON metadata

  message     AIMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model AIImage {
  id              String          @id @default(uuid())
  userId          String
  conversationId  String
  messageId       String?
  storageKey      String
  imageUrl        String
  prompt          String
  revisedPrompt   String?
  model           String          @default("pollinations-v1")
  preset          String          @default("photorealistic")
  aspectRatio     String          @default("1:1")
  parentImageId   String?
  metadata        String?         // JSON parameters
  createdAt       DateTime        @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation    AIConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message         AIMessage?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  parentImage     AIImage?        @relation("ImageEditChain", fields: [parentImageId], references: [id], onDelete: SetNull)
  childImages     AIImage[]       @relation("ImageEditChain")
}

model AIMemory {
  id        String   @id @default(uuid())
  userId    String
  content   String
  category  String   @default("PREFERENCE") // PREFERENCE, FACT, INSTRUCTION
  source    String   @default("USER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AIUsage {
  id            String   @id @default(uuid())
  userId        String
  requestType   String   // TEXT, IMAGE, IMAGE_EDIT, FILE_ANALYSIS
  model         String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  imageCount    Int      @default(0)
  estimatedCost Float    @default(0.0)
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

